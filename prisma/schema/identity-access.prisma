model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name")
  lastName        String?    @map("last_name")
  phone           String?
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles             UserRole[]
  vendor            Vendor?
  carts             Cart[]
  masterOrders      MasterOrder[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// NOT part of the approved Identity & Access architecture
/// (docs/database/identity-access.md lists `RefreshToken` under "Future
/// Extensions", and docs/plans/database-implementation-plan.md's deferred
/// list agrees). Added minimally in Phase 5 for persisted refresh tokens;
/// extended minimally in Phase 6 (`familyId`, `revokedAt`) to support
/// rotation + reuse detection — see that phase's final report for the
/// full design rationale. `familyId` is a plain grouping value (not a
/// separate TokenFamily table/FK): every token descended from one login
/// shares the same value, generated fresh only at login. `revokedAt`
/// serves double duty as "consumed by rotation" and "revoked because
/// reuse was detected in this family" — both mean the same thing to a
/// caller (this token can never be used again), so one field is enough;
/// a `replacedBy`-style audit trail was deliberately not added since
/// nothing in this phase's algorithm needs to walk the chain, only to
/// know a token's own revoked state and its family.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @default(uuid(7)) @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_tokens")
}
