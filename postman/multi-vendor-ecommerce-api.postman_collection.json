{
  "info": {
    "_postman_id": "3f0d9b1a-6e2a-4a2b-9b1a-6e2a4a2b9b1a",
    "name": "Multi-Vendor E-Commerce API",
    "description": "Real, implemented endpoints only (Phases 1-16). No Wallet/Commission, Promotion/Coupon, Review, Notification, or Audit endpoints exist yet - their Prisma models exist but have no application layer. No ProductVariant/Inventory management endpoint exists either, so `variantId` must be set manually (e.g. via prisma/seed.ts or Prisma Studio) before running Cart requests. ADMIN-only requests (Category create/update, Refund create) require `adminAccessToken` to be set manually, since no self-service admin-provisioning endpoint exists - assign the ADMIN role to a seeded user directly via Prisma.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [{ "key": "baseUrl", "value": "{{baseUrl}}" }],
  "item": [
