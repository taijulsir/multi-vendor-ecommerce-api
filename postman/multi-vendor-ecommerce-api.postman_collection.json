    {
      "name": "03 RBAC / Authorization Demo",
      "description": "Demonstration-only endpoints exercising AuthorizationGuard end to end (not real business endpoints). Role-based requests below work with any seeded ADMIN/VENDOR account. Permission-based requests (products:read, inventory:adjust) require Permission/RolePermission rows that are NOT seeded by prisma/seed.ts by design (see docs/database/identity-access.md) -- create them manually via Prisma Studio/direct DB access first, or expect 403.",
      "item": [
        {
          "name": "Requires ADMIN role",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/rbac-demo/role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "rbac-demo", "role"]
            }
          }
        },
        {
          "name": "Requires products:read permission",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/rbac-demo/permission",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "rbac-demo", "permission"]
            },
            "description": "Requires a Permission(resource='products', action='read') granted to the caller's role -- not seeded by default."
          }
        },
        {
          "name": "Requires ADMIN role AND products:read permission",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/rbac-demo/role-and-permission",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "rbac-demo", "role-and-permission"]
            },
            "description": "Requires the caller to be ADMIN AND have products:read -- the permission is not seeded by default."
          }
        },
        {
          "name": "Requires ADMIN or VENDOR role (any)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/rbac-demo/roles-any",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "rbac-demo", "roles-any"]
            }
          }
        },
        {
          "name": "Requires products:read AND inventory:adjust permissions (all)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/rbac-demo/permissions-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "rbac-demo", "permissions-all"]
            },
            "description": "Requires both permissions granted to the caller's role -- neither is seeded by default."
          }
        }
      ]
    },
