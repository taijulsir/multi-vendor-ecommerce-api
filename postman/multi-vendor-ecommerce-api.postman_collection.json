          "name": "Get my vendor profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vendors/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vendors", "me"]
            }
          }
        },
        {
          "name": "Update vendor verification status (ADMIN)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationStatus\": \"UNDER_REVIEW\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/vendors/{{vendorId}}/verification",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vendors", "{{vendorId}}", "verification"]
            },
            "description": "Only PENDING->UNDER_REVIEW, UNDER_REVIEW->VERIFIED, PENDING/UNDER_REVIEW->REJECTED are accepted. Run this request three times (UNDER_REVIEW, then VERIFIED) before Activation below."
          }
        },
        {
          "name": "Activate vendor (ADMIN)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vendors/{{vendorId}}/activation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vendors", "{{vendorId}}", "activation"]
            },
            "description": "Requires status=PENDING and verificationStatus=VERIFIED (run the verification request(s) above first)."
          }
        }
      ]
