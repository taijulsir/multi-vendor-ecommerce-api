    {
      "name": "15 Payments",
      "item": [
        {
          "name": "Create payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('paymentId', body.id);",
                  "  if (body.attempts && body.attempts.length) {",
                  "    pm.environment.set('paymentProviderReference', body.attempts[0].providerReference);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
