# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://ecommerce:YOUR_PASSWORD@localhost:5433/multi_vendor_ecommerce"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: each must be a random string of
# at least 32 characters, and the two must differ from each other — both
# are validated at startup (Phase 24, src/config/env.validation.ts).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local file storage (Phase 22 — Product Images). Never a cloud/object
# storage bucket URL: a filesystem path only. In production this must
# point at a persistent mounted volume (see docs/architecture.md) —
# a container's ephemeral filesystem otherwise loses uploads on redeploy.
FILE_STORAGE_DIR=./storage/uploads

# Rate limiting (Redis-backed, src/throttler/). All optional — every
# value below falls back to a strict, production-sensible default if
# unset (src/throttler/throttle-config.ts's THROTTLE_DEFAULTS: 100
# globally, 5 for login/register, 10 for refresh, 20 each for the
# webhook/image-upload/checkout routes, all per THROTTLE_TTL_MS).
# The values below are deliberately generous, dev/CI-friendly numbers —
# the full e2e suite alone makes 100+ register/login calls within a
# single window (every e2e spec file shares this same Redis-backed
# counter, and the whole suite runs in well under a minute), which a
# production-appropriate limit would legitimately reject. Production
# should NOT reuse these; set stricter values in .env.production
# instead (see docs/deployment.md's Environment Variables table for the
# recommended production numbers, which match the coded defaults above).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=2000
THROTTLE_AUTH_LOGIN_LIMIT=1000
THROTTLE_AUTH_REGISTER_LIMIT=1000
THROTTLE_AUTH_REFRESH_LIMIT=500
THROTTLE_PAYMENTS_WEBHOOK_LIMIT=500
THROTTLE_PRODUCT_IMAGE_UPLOAD_LIMIT=500
THROTTLE_CHECKOUT_LIMIT=500
